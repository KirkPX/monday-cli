# Export these in CI and automation. The CLI does not load a .env file by itself.
# Precedence: command flags > these env vars > settings file / keychain > defaults.

# API key. Interactively, prefer `monday login` (stored in the OS keychain).
# In CI and for agents, set this instead. The keychain is usually unavailable there.
MONDAY_API_KEY=

# Override the API base URL (defaults to https://api.monday.com).
# MONDAY_BASE_URL=https://api.monday.com

# Named account (defaults to "default").
# MONDAY_ACCOUNT=default

# Refuse every command that would change remote data. The safe choice for agents
# and automation. Set to 0 to let one run write when the settings file says
# "readOnly": true.
# MONDAY_READ_ONLY=1

# Use this settings file instead of the default one (`monday config path`).
# MONDAY_CLI_CONFIG_FILE=./monday-config.json

# The settings folder follows the platform: XDG_CONFIG_HOME where it is set, and
# APPDATA on Windows.

# Pick the credential store instead of keychain-then-file. "memory" keeps the key
# for one process only, and tests set it so they can never touch real credentials.
# "file" always uses the private credentials file.
# MONDAY_CLI_CREDENTIAL_STORE=memory

# Where the key is kept when the OS keychain is closed (as over SSH on macOS).
# MONDAY_CLI_CREDENTIALS_FILE=./credentials.json

# Stop `monday login` opening a browser. Set suite-wide in vitest.config.ts,
# and useful on a headless machine where the browser has nowhere to open.
# MONDAY_CLI_NO_BROWSER=1

# Ask Monday for one API version. Leave unset to get the current one: an expired
# version raises no error, and Monday answers with far fewer fields.
# MONDAY_API_VERSION=

# `monday login --oauth` only: your Monday app's ID and secret. The ID can also be
# set with `monday config set oauthClientId <id>`. Without this variable, the CLI
# asks for the secret once and keeps it in the keychain.
# MONDAY_CLIENT_ID=
# MONDAY_CLIENT_SECRET=

# Where the OAuth sign-in goes. Tests point this at a local server.
# MONDAY_OAUTH_BASE_URL=https://auth.monday.com
